[Unit]
Description=TinBoker news ingest (RSS feeds -> shared knowledge wiki)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/tinboker/pipelines/services/news
ExecStart=/root/tinboker/pipelines/services/news/scripts/run_news.sh
# P6: pipeline secrets (WIKI_DATABASE_URL, OPENROUTER_API_KEY, ...) come from this
# env file. Leading "-" = optional, so the unit still starts before the operator
# has created it and shared.secrets falls back to GSM. KEY=value per line, no
# quotes needed, "#" comments — see pipelines/libs/shared/src/shared/secrets.py.
EnvironmentFile=-/root/tinboker/pipelines/.env
# Still required: the article store reads GCS with this service account.
Environment=GOOGLE_APPLICATION_CREDENTIALS=/root/tinboker/pipelines/services/podcast/gcp-service-account.json
# Python block-buffers stdout under systemd, so a run killed at the timeout left an
# empty journal and nothing to say where it had stopped.
Environment=PYTHONUNBUFFERED=1
# A single run is bounded; cap it so a hung fetch cannot wedge the timer.
TimeoutStartSec=1800
