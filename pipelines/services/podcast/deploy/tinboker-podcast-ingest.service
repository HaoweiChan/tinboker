[Unit]
Description=TinBoker podcast ingest — new episodes to summary, then syndication
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/tinboker/pipelines/services/podcast
ExecStart=/root/tinboker/pipelines/services/podcast/scripts/run_scheduled_ingest.sh
# Pipeline secrets, including SYNDICATE_AUTOPUBLISH. Leading "-" = optional, so the unit
# still starts before the operator has created it and shared.secrets falls back to GSM.
EnvironmentFile=-/root/tinboker/pipelines/.env
Environment=GOOGLE_APPLICATION_CREDENTIALS=/root/tinboker/pipelines/services/podcast/gcp-service-account.json
# content_builder models. podcast-api.service carries the same two lines; this unit runs
# the LangGraph pipeline in-process, so without them the scheduled run resolves no model
# for any role. Keep the pair in sync with .github/workflows/pipelines-deploy.yml — the
# per-role pin exists because the Threads copy is judged on voice, not accuracy.
Environment=PIPELINE_LLM_MODEL=openrouter:deepseek/deepseek-v4-pro
Environment=SOCIAL_COPY_WRITER_MODEL=openrouter:google/gemini-3.7-flash
# extractor pinned to flash: it is the ONLY role that receives {sentences} (the raw
# transcript), so it alone accounts for the bulk of prompt-token spend — 30 days of
# v4-pro was 175M prompt tokens, 84% of the whole OpenRouter bill. Measured on 4
# episodes (537 / 800 / 1102 / 2732 sentences), flash-0731 matched v4-pro on every
# correctness axis that matters here — 100% sentence coverage, no out-of-range index
# ranges, no off-vocabulary segment_type, no simplified glyphs — and consolidate_chapters
# normalised the higher raw event count to the SAME chapter count (4 vs 4, 8 vs 8),
# because _target_chapter_count is driven by duration, not by how finely the extractor
# split. Cost per episode fell 93-98%. The 2026-06 bake-off that chose v4-pro judged
# tag vocabulary and ticker linking — both the writer's and ticker_extractor's job, on
# {events}, not the transcript — so the role burning the tokens was never the one the
# decision was about. Those roles stay on v4-pro via PIPELINE_LLM_MODEL above.
Environment=EXTRACTOR_MODEL=openrouter:deepseek/deepseek-v4-flash-0731
# Provider pin. OpenRouter serves one model from many providers and does NOT sort them
# by price: measured 2026-09-19 on deepseek-v4-pro, 16 providers spanning 3.7x in posted
# input price (StreamLake $0.513/M fp8 .. Azure/NextBit $1.910/M) and 8x in what we
# actually paid, because prompt-cache hits land per-provider. The expensive tail buys
# nothing — AtlasCloud/BaseTen serve fp4 (lower precision) at 3.3x StreamLake's fp8 rate,
# and StreamLake matched Azure on throughput (71-97 tok/s). Fallbacks stay enabled, so
# this is a price preference and an outage at the pinned providers cannot stall ingest.
Environment=OPENROUTER_PROVIDER_ORDER=StreamLake,Baidu
# Local Whisper endpoint for shows on transcript_service "local" (股癌 today). The Mac
# mini serves ggml-large-v3-turbo over Tailscale; whisper.cpp's whisper-server exposes
# /inference rather than the OpenAI route, hence the explicit path. If the Mac is
# unreachable — FileVault is on with no auto-login, so an unattended reboot leaves it at
# the unlock prompt — FallbackTranscriptService pays Groq for that episode instead of
# losing it. Compared on five 股癌 episodes (EP694-698) against their stored
# whisper-large-v3 transcripts: 99.4% entity recall, 0.1 simplified glyphs per 1,000,
# coverage within 30s of the incumbent, no repetition loops, 16.6x realtime.
Environment=LOCAL_WHISPER_BASE_URL=http://100.80.151.88:8910
Environment=LOCAL_WHISPER_TRANSCRIBE_PATH=/inference
# sector_verifier is the shape a decisions model is built for — one yes/no per candidate,
# and nothing downstream reads its prose. The code path exists (SECTOR_VERIFIER_MODEL=
# decisions:typesafe/jev-1.13) and is ~97% cheaper, but it is deliberately NOT enabled:
# A/B'd 2026-09-19 against the incumbent on the real in-flight candidates of one 股癌
# episode, Jev agreed on only 12/17, and no cutoff fixes it (best 19/26 at p>=0.70; at
# p>=0.90 it keeps nothing). It rates the same sector+keyword 0.84/0.82/0.37 across three
# contexts, and its misses are the expensive direction — it kept 面板 where the transcript
# meant a faceplate, not display panels, which is exactly the homonym the verifier exists
# to catch. An easy hand-built set scored 6/6 and hid all of this. Re-A/B before enabling.
# Environment=SECTOR_VERIFIER_MODEL=decisions:typesafe/jev-1.13
# Local models: set LOCAL_LLM_BASE_URL (e.g. http://mac-mini:11434/v1, over a tunnel) and
# prefix a role's model with `local:` — e.g. EXTRACTOR_MODEL=local:qwen3:30b-a3b-instruct-2507-q4_K_M.
# Left unset: the pipeline runs on the VPS and the Mac mini is not reachable from it yet.
Environment=TINBOKER_PLATFORM_API_URL=https://api.tinboker.com
# Admin endpoints (/api/admin/*) are mounted on dev and staging only — production skips
# them so api.tinboker.com exposes no admin surface. All envs share one database, so
# staging does the same work to the same data. The staging container publishes
# 127.0.0.1:8002 on this same host; going direct skips Cloudflare, whose 100s edge
# timeout 524'd the Threads catch-up publish (the origin kept working, so the run log
# showed a failure while the posts went live).
Environment=TINBOKER_ADMIN_API_URL=http://127.0.0.1:8002
# A ceiling against a wedged run holding the timer, not a target — so it has to sit above
# the longest legitimate run and below the timer's 6h cadence. 2h was under the real
# envelope: a tick with a back-catalogue backlog works through ~6 shows in 2h (10 shows x
# up to 10 unprocessed episodes each), so runs land anywhere from ~1h20 to well past 2h
# and systemd was SIGTERMing healthy runs mid-episode. 5h clears the observed worst case
# and still leaves an hour before the next tick.
TimeoutStartSec=18000
