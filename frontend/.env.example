# API Base URL Configuration
# Set this to your backend API endpoint
# Example: https://staging-api.tinboker.com
# Example: http://localhost:3000
# VITE_API_BASE_URL=https://staging-api.tinboker.com
VITE_API_BASE_URL=http://localhost:3000
# Stage/Environment setting (DEV, STAGING, PRODUCTION)
VITE_STAGE=DEV
# Newsletter / subscription CTA destination (e.g. Substack URL).
# Leave unset/empty to hide all newsletter CTA blocks (degrade-safe).
# VITE_NEWSLETTER_URL=https://yournewsletter.substack.com
