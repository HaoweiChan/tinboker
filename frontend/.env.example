# API Base URL Configuration
# Set this to your backend API endpoint
# Example: https://staging-api.tinboker.com
# Example: http://localhost:3000
# VITE_API_BASE_URL=https://staging-api.tinboker.com
VITE_API_BASE_URL=http://localhost:3000
# Stage/Environment setting (DEV, STAGING, PRODUCTION)
VITE_STAGE=DEV
# Paid full-edition destination for the subscription funnel (issue #425).
# Articles may override this per-article via their subscribe_url field.
VITE_SUBSTACK_URL=https://tinboker.substack.com/subscribe
