# Environment files — never commit real secrets
.env
.env.*
!.env.example

# graphify: local / machine-specific state (absolute paths, breaks across machines)
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.graphify_root
graphify-out/.graphify_incremental.json
graphify-out/.graphify_python
graphify-out/.graphify_detect.json
graphify-out/.graphify_uncached.txt
graphify-out/cost.json
# shared outputs (graph.json, GRAPH_REPORT.md, graph.html, wiki/) are committed

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Node
node_modules/

# Build outputs
dist/
build/
.next/
out/

# IDE
.vscode/
.idea/

# oh-my-claudecode local state (per-machine; not shared)
.omc/

# Local Marp deck preview renders (scratch; regenerate via card_deck)
marp-examples/

# Local technical blog drafts
tech-blogs/
tide-tw-data/

# ai-ops pre-edit backups (docs/ai-ops/40-maintenance-protocol.md §2) — scratch by
# design; existing files from founding PR #415 stay tracked for history, new ones
# shouldn't be (already-tracked files are unaffected by this pattern)
docs/ai-ops/_backups/*
