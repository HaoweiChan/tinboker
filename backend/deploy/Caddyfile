# ============================================================================
# TinBoker — CANONICAL Caddy reverse-proxy config (host systemd service)
# ============================================================================
# THIS FILE IS DEPLOYED. .github/workflows/backend-deploy.yml syncs it to
# /etc/caddy/Caddyfile on the VPS on every dev/staging/prod backend deploy:
# it `caddy validate`s this file, copies it to /etc/caddy/Caddyfile, then runs
# `systemctl reload caddy`. Caddy runs as a HOST systemd service (User=caddy,
# caddy v2.10.x) — NOT a Docker container.
#
# To change routing: edit THIS file → PR → merge. Do NOT hand-edit
# /etc/caddy/Caddyfile on the VPS; it is overwritten on the next deploy.
#
# One shared Netdata (localhost:19999) serves every env's /netdata/*.
# ============================================================================

# TinBoker Caddyfile
# Multi-environment setup
# 
# Frontend: Served by Cloudflare Pages (tinboker.com, www.tinboker.com)
# Backend: Served by VPS (api.tinboker.com, dev-api.tinboker.com, staging-api.tinboker.com)

# ==========================================
# Production API: api.tinboker.com (port 8000)
# With Netdata monitoring on /netdata/*
# ==========================================
api.tinboker.com {
	encode gzip

	# Netdata monitoring dashboard
	handle /netdata/* {
		uri strip_prefix /netdata
		reverse_proxy localhost:19999
	}

	# Default: API proxy
	handle {
		reverse_proxy localhost:8000
	}

	log {
		output file /var/log/caddy/api-access.log
		format json
	}
}

# ==========================================
# Development API: dev-api.tinboker.com (port 8001)
# ==========================================
dev-api.tinboker.com {
	encode gzip

	# Netdata monitoring dashboard
	handle /netdata/* {
		uri strip_prefix /netdata
		reverse_proxy localhost:19999
	}

	# Default: API proxy
	handle {
		reverse_proxy localhost:8001
	}

	log {
		output file /var/log/caddy/dev-api-access.log
		format json
	}
}

# ==========================================
# Staging API: staging-api.tinboker.com (port 8002)
# With Netdata monitoring on /netdata/*
# ==========================================
staging-api.tinboker.com {
	encode gzip

	# Netdata monitoring dashboard
	handle /netdata/* {
		uri strip_prefix /netdata
		reverse_proxy localhost:19999
	}

	# Default: API proxy
	handle {
		reverse_proxy localhost:8002
	}

	log {
		output file /var/log/caddy/staging-api-access.log
		format json
	}
}

# ==========================================
# Development Frontend: dev.tinboker.com
# (Still served from VPS for development)
# ==========================================
dev.tinboker.com {
	encode gzip

	handle /api/* {
		reverse_proxy localhost:8001
	}

	handle /ws/* {
		reverse_proxy localhost:8001
	}

	handle /health {
		reverse_proxy localhost:8001
	}

	handle {
		root * /var/www/html-dev
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/dev-access.log
		format json
	}
}

# ==========================================
# Direct IP access (for health checks)
# ==========================================
:80 {
	encode gzip

	handle /api/* {
		reverse_proxy localhost:8000
	}

	handle /health {
		reverse_proxy localhost:8000
	}

	respond "VPS is running" 200
}

# ==========================================
# Podcast / Wiki content API: podcast-api.tinboker.com (port 8003)
# tinboker-agents — /api/podcast/*, /api/episodes/*, /api/wiki/*
# ==========================================
podcast-api.tinboker.com {
	encode gzip

	# Static media files (Phase E: GCS -> VPS blob store)
	handle /media/* {
		root * /var/lib/tinboker
		file_server
	}

	# The pipelines app has no prod/dev split of its own (single instance), so its
	# Swagger/ReDoc and schema are blocked here rather than in app code. They map
	# every route incl. the key-gated write endpoints (/api/wiki/ingest/episode,
	# /api/watcher/trigger, ...). The backend's own docs are gated in main.py by
	# settings.is_production instead.
	@apidocs path /docs /docs/* /redoc /redoc/* /openapi.json
	handle @apidocs {
		respond 404
	}

	# /api/* is not reachable from outside this host. No public consumer exists:
	# neither the frontend nor the main backend calls this hostname, and three months
	# of access log show anonymous /api traffic is almost entirely scanners
	# (/api/.env, /api/v1/.env, TLM-Audit-Scanner — 333 of 431 hits were 404s).
	#
	# Deliberately NOT an X-API-Key check: only the write routes verify the key, the
	# read routes have no auth dependency at all, so a header check would let any
	# value through — and this repo is public, so that bypass would be documented
	# here. Network scope is the honest gate. To reach it from a workstation:
	#   ssh -L 8003:localhost:8003 root@<vps>   then curl localhost:8003
	#
	# /media/* deliberately stays public below — article covers are fetched by real
	# browsers, Googlebot-Image and facebookexternalhit, and by the cover pipeline.
	@api_external {
		path /api/*
		not remote_ip 127.0.0.1 ::1 private_ranges
	}
	handle @api_external {
		respond 403
	}

	# Content API
	handle {
		reverse_proxy localhost:8003
	}

	log {
		output file /var/log/caddy/podcast-api-access.log
		format json
	}
}
